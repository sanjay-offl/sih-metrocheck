# ─────────────────────────────────────────────────────────────
# MetroCheck — environment template
# Copy to `.env` for docker-compose, and see backend/.env for
# running the FastAPI service directly.
# ─────────────────────────────────────────────────────────────

# Google Gemini API key (https://aistudio.google.com/apikey)
# Required for AI vision extraction. If unset, MetroCheck falls
# back to Tesseract OCR + heuristic parsing.
GEMINI_API_KEY=

# Optional: override the vision model
GEMINI_MODEL=gemini-2.0-flash

# Signing key for JWT access tokens — generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change_me_to_a_long_random_string

# Postgres credentials used by the postgres service
POSTGRES_USER=metrocheck
POSTGRES_PASSWORD=metrocheck123
POSTGRES_DB=metrocheck_db
